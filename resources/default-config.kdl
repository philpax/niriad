    // Switches focus between the current and the previous workspace.
    // Mod+Tab { focus-workspace-previous; }
    //
    // The following binds move the focused window in and out of a section.
    // If the window is alone, they will consume it into the nearby section to the side.
    // If the window is already in a section, they will expel it out.
    // Mod+BracketLeft  { consume-or-expel-window-left; }
