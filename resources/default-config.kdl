    // Mod+Shift+Ctrl+J     { move-section-to-monitor-down; }
    // Mod+Shift+Ctrl+K     { move-section-to-monitor-up; }
    // Mod+Shift+Ctrl+L     { move-section-to-monitor-right; }
    //
    // Mod+U              { focus-workspace-down; }
    // Mod+I              { focus-workspace-up; }
    // Mod+Ctrl+Page_Down { move-section-to-workspace-down; }
    // Mod+Ctrl+Page_Up   { move-section-to-workspace-up; }
    // Mod+Ctrl+U         { move-section-to-workspace-down; }
    // Mod+Ctrl+I         { move-section-to-workspace-up; }
    //
    // Mod+Shift+Page_Down { move-workspace-down; }
    // Mod+Shift+Page_Up   { move-workspace-up; }
    // Mod+Shift+U         { move-workspace-down; }
